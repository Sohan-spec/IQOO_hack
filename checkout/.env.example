# 32+ random bytes, hex-encoded. Phone C5 must send this as
# Authorization: Bearer … or X-Confirm-Secret. Never put it in the Pay HTML.
CHECKOUT_CONFIRM_SECRET=PLACEHOLDER-NOT-REAL
